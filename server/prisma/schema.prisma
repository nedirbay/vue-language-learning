// DevHub Prisma schema
// To regenerate: cd server && pnpm prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PricingType {
  FREE
  PAID
  OPEN_SOURCE
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  username        String      @unique
  fullName        String
  passwordHash    String
  avatarUrl       String?
  bio             String?
  role            UserRole    @default(USER)
  status          UserStatus  @default(ACTIVE)
  emailVerified   Boolean     @default(false)
  emailToken      String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  projects        Project[]
  orders          Order[]
  reviews         Review[]
  favorites       Favorite[]
  posts           BlogPost[]
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  projects    Project[]
  createdAt   DateTime @default(now())
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  projects  Project[] @relation("ProjectTags")
  createdAt DateTime @default(now())
}

model Project {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  shortDescription   String
  description        String
  coverImageUrl      String
  videoUrl           String?
  pricingType        PricingType   @default(FREE)
  priceCents         Int           @default(0)
  currency           String        @default("USD")
  status             ProjectStatus @default(DRAFT)
  featured           Boolean       @default(false)
  trending           Boolean       @default(false)
  techStack          String[]
  installation       String?
  features           String[]
  changelog          Json?
  screenshots        Json?
  githubUrl          String?
  liveDemoUrl        String?
  documentationUrl   String?
  downloadUrl        String?
  rating             Float         @default(0)
  reviewCount        Int           @default(0)
  likeCount          Int           @default(0)
  viewCount          Int           @default(0)
  downloadCount      Int           @default(0)
  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id])
  authorId           String
  author             User          @relation(fields: [authorId], references: [id])
  tags               Tag[]         @relation("ProjectTags")
  orders             Order[]
  reviews            Review[]
  favorites          Favorite[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([pricingType])
  @@index([status])
}

model Review {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  body       String
  createdAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, projectId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  projectId         String
  project           Project     @relation(fields: [projectId], references: [id])
  amountCents       Int
  currency          String      @default("USD")
  status            OrderStatus @default(PENDING)
  stripeSessionId   String?     @unique
  stripePaymentId   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  body            String
  coverImageUrl   String?
  tags            String[]
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  publishedAt     DateTime @default(now())
  readingMinutes  Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
