# Server config
PORT=4000
NODE_ENV=development

# Database (PostgreSQL). For local dev with docker-compose use:
# postgresql://devhub:devhub@localhost:5432/devhub?schema=public
DATABASE_URL=postgresql://devhub:devhub@localhost:5432/devhub?schema=public

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=also-change-me
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Stripe — leave empty in dev; the payments module degrades gracefully.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/#/checkout/mock-success
STRIPE_CANCEL_URL=http://localhost:5173/#/projects

# Uploads
UPLOAD_DIR=./uploads
